# ==============================================================================
# GYM VIP (VIP CENTER FIT) — CONFIGURACIÓN DE ENTORNO BACKEND
# ==============================================================================
# NOTA: Este archivo es una plantilla de ejemplo. Copie este archivo como .env
# en la raíz de gymvip-backend/ para sobreescribir valores en ejecución local.
# En Render, configure estas variables en Environment Variables del dashboard.
# ==============================================================================

# Perfil activo: dev (con H2 persistente o Postgres) | prod (PostgreSQL obligatorio con Flyway)
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor backend (Render inyecta PORT automáticamente)
PORT=8080

# URL de conexión JDBC a PostgreSQL (Usar jdbc:postgresql://... con sslmode=require para Render externo)
# Ejemplo Render Externo: jdbc:postgresql://dpg-xxxxxx-a.oregon-postgres.render.com:5432/gymvip_db?sslmode=require
# Ejemplo Local: jdbc:postgresql://localhost:5432/gymvip
DB_JDBC_URL=jdbc:h2:file:./data/gymvip;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;AUTO_SERVER=TRUE

# Credenciales de base de datos
DB_USERNAME=sa
DB_PASSWORD=

# Orígenes CORS permitidos (separados por coma, sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

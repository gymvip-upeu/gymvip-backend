# ==============================================================================
# GYM VIP (VIP CENTER FIT) — CONFIGURACIÓN DE ENTORNO BACKEND
# ==============================================================================
# NOTA: Este archivo es una plantilla de ejemplo sin secretos. Copie este archivo
# como .env en la raíz de gymvip-backend/ para configurar la ejecución local.
# En Render, configure estas variables en Environment Variables del dashboard.
# ==============================================================================

# Perfil activo: dev (PostgreSQL desarrollo) | prod (PostgreSQL Render con ddl-auto=validate y Flyway)
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor backend (usar 8081 si 8080 se encuentra ocupado localmente)
PORT=8081

# URL de conexión JDBC a PostgreSQL (Render externo con SSL obligatorio)
# Formato: jdbc:postgresql://HOST_EXTERNO_RENDER:5432/DATABASE_NAME?sslmode=require
DB_JDBC_URL=jdbc:postgresql://dpg-xxxxxx-a.oregon-postgres.render.com:5432/gymvip?sslmode=require

# Credenciales de base de datos PostgreSQL
DB_USERNAME=gymvip_user
DB_PASSWORD=CAMBIAR_POR_TU_PASSWORD_RENDER

# Esquema aislado para ejecución de pruebas sin alterar el esquema compartido public
TEST_DB_SCHEMA=gymvip_test_jorge
MEMBERSHIP_UPCOMING_DAYS=7

# Métodos presenciales propuestos; ratificar con Wagner. Agregar POS solo tras configurarlo.
MEMBERSHIP_PAYMENT_METHODS=EFECTIVO,YAPE,PLIN,TRANSFERENCIA

# Pool de conexiones HikariCP (tamaño moderado para permitir conexiones concurrentes de desarrolladores)
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Orígenes CORS permitidos (separados por coma, sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Provisión inicial de contraseñas de personal (HU-04)
# En producción, utilice contraseñas robustas y seguras
APP_ADMIN_INITIAL_PASSWORD=Admin123!
APP_RECEPCION_INITIAL_PASSWORD=Recepcion123!

# Configuración de seguridad JWT (HS256)
# En producción (Render), JWT_SECRET es OBLIGATORIO y debe tener al menos 32 caracteres (256 bits)
JWT_SECRET=ejemplo_clave_secreta_jwt_de_al_menos_32_caracteres_no_produccion_2026
JWT_EXPIRATION_HOURS=24

APP_COMMS_URL=http://localhost:8085
APP_COMMS_TOKEN=replace-with-private-shared-service-token
REMINDERS_SCHEDULE_ENABLED=false
# CulqiLink: usa primero la clave SECRETA de PRUEBA. Nunca se envía al frontend ni a la APK.
CULQI_SECRET_KEY=
# Mantener false hasta finalizar las pruebas de conciliación y habilitar cobros reales.
CULQI_LIVE_ENABLED=false

# Firebase del servidor: cuenta de servicio privada codificada en base64. No confundir con google-services.json de Android.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
# Alternativa al base64: archivo privado montado de solo lectura en el servidor.
# FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-admin.json

# Acceso de socios por correo (prueba local)
MEMBER_ACCESS_ACTIVATION_URL=http://127.0.0.1:5173/activar-cuenta
PASSWORD_RESET_BASE_URL=http://127.0.0.1:5173/restablecer-contrasena

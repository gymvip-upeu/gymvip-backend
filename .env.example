# ==============================================================================
# GYM VIP (VIP CENTER FIT) — CONFIGURACIÓN DE ENTORNO BACKEND
# ==============================================================================
# NOTA: Este archivo es una plantilla de ejemplo sin secretos. Copie este archivo
# como .env en la raíz de gymvip-backend/ para configurar la ejecución local.
# En Render, configure estas variables en Environment Variables del dashboard.
# ==============================================================================

# Perfil activo: dev (PostgreSQL desarrollo) | prod (PostgreSQL Render con ddl-auto=validate y Flyway)
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor backend (usar 8081 si 8080 se encuentra ocupado localmente)
PORT=8081

# URL de conexión JDBC a PostgreSQL (Render externo con SSL obligatorio)
# Formato: jdbc:postgresql://HOST_EXTERNO_RENDER:5432/DATABASE_NAME?sslmode=require
DB_JDBC_URL=jdbc:postgresql://dpg-xxxxxx-a.oregon-postgres.render.com:5432/gymvip?sslmode=require

# Credenciales de base de datos PostgreSQL
DB_USERNAME=gymvip_user
DB_PASSWORD=CAMBIAR_POR_TU_PASSWORD_RENDER

# Esquema aislado para ejecución de pruebas sin alterar el esquema compartido public
TEST_DB_SCHEMA=gymvip_test

# Pool de conexiones HikariCP (tamaño moderado para permitir conexiones concurrentes de desarrolladores)
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Orígenes CORS permitidos (separados por coma, sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Provisión inicial de contraseñas de personal (HU-04)
# En producción, utilice contraseñas robustas y seguras
APP_ADMIN_INITIAL_PASSWORD=Admin123!
APP_RECEPCION_INITIAL_PASSWORD=Recepcion123!

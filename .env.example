# ==============================================================================
# GYM VIP (VIP CENTER FIT) — CONFIGURACIÓN DE ENTORNO BACKEND
# ==============================================================================
# NOTA: Este archivo es una plantilla de ejemplo. Copie este archivo como .env
# en la raíz de gymvip-backend/ para sobreescribir valores en ejecución local.
# En Render, configure estas variables en Environment Variables del dashboard.
# ==============================================================================

# Perfil activo: dev (PostgreSQL local) | prod (PostgreSQL obligatorio con ddl-auto=validate y Flyway)
SPRING_PROFILES_ACTIVE=dev

# Puerto del servidor backend (Render inyecta PORT automáticamente en producción)
PORT=8080

# URL de conexión JDBC a PostgreSQL
# Ejemplo Local:
DB_JDBC_URL=jdbc:postgresql://localhost:5432/gymvip
# Ejemplo Render Externo:
# DB_JDBC_URL=jdbc:postgresql://dpg-xxxxxx-a.oregon-postgres.render.com:5432/gymvip_db?sslmode=require

# Credenciales de base de datos PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Orígenes CORS permitidos (separados por coma, sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Provisión inicial de contraseñas de personal (HU-04)
# En producción, utilice contraseñas robustas y seguras
APP_ADMIN_INITIAL_PASSWORD=Admin123!
APP_RECEPCION_INITIAL_PASSWORD=Recepcion123!
